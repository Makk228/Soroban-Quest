# Скопируйте файл в .env перед запуском: cp .env.example .env
# Секреты не хранятся в коде и не попадают в репозиторий (.env в .gitignore).

POSTGRES_DB=soroban
POSTGRES_USER=soroban
POSTGRES_PASSWORD=soroban-local-password
POSTGRES_PORT=5432

SERVER_PORT=8080

# Ключ подписи JWT: минимум 32 байта.
# Сгенерировать новый: openssl rand -base64 48  (или: head -c 48 /dev/urandom | base64)
SOROBAN_JWT_SECRET=change-me-please-at-least-32-bytes-long-secret

# Часовой пояс, по которому считаются дневные серии и границы недели
SOROBAN_TIME_ZONE=UTC

LOG_LEVEL=INFO
